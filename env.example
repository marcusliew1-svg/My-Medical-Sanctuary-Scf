# MMS Zoho CRM integration placeholders. Do not commit real secrets.
# Server-side only. Do not prefix any Zoho secret with NEXT_PUBLIC_.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=
ZOHO_ORGANIZATION_ID=
ZOHO_CRM_OWNER_ID=
ZOHO_LEADS_MODULE_API_NAME=Leads
MMS_DEFAULT_LEAD_SOURCE=Website Discovery Form
MMS_CRM_DEBUG=true

# Stripe commerce placeholders. Server-side secrets must never use NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ASCEND=
STRIPE_PRICE_EVOLVE=
STRIPE_PRICE_ETERNA=
STRIPE_PRICE_PINNACLE=

# Commerce/recruitment feature gates. Keep false until integrations and policies are approved.
MMS_STRIPE_CHECKOUT_ENABLED=false
MMS_SALES_PARTNER_APPLICATIONS_ENABLED=false
MMS_CAREERS_APPLICATIONS_ENABLED=false

# Optional downstream routing identifiers once the Zoho modules/workflows are confirmed.
MMS_SALES_PARTNER_MODULE_API_NAME=
MMS_SALES_PARTNER_LEAD_SOURCE=MMS Website Sales Partner Application
MMS_CAREERS_SYSTEM=zoho_recruit
MMS_CAREERS_OWNER_ID=

# Health education / SEO gates.
# Keep false until clinical, regulatory and Malaysian healthcare-advertising review is complete.
MMS_HEALTH_EDUCATION_INDEXABLE=false
MMS_MEDICAL_EDUCATION_INDEXABLE=false
