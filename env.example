# MMS Zoho CRM integration placeholders. Do not commit real secrets.
# Server-side only. Do not prefix any Zoho secret with NEXT_PUBLIC_.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=com
ZOHO_ORGANIZATION_ID=
ZOHO_CRM_OWNER_ID=
ZOHO_LEADS_MODULE_API_NAME=Leads
MMS_DEFAULT_LEAD_SOURCE=Website Discovery Form
MMS_CRM_DEBUG=true

# Protected internal MMS commercial operations API.
# Use a long random server-side token. Never expose this token to browser code.
MMS_INTERNAL_API_TOKEN=
# Finance-sensitive payment clearance uses a separate server-side credential.
# Ordinary internal Sales Partner tooling must never receive this token.
MMS_FINANCE_API_TOKEN=
# Canonical public MMS website URL used to generate permanent Partner referral URLs after activation.
MMS_SITE_URL=https://www.scf.center/
# Public canonical base used by sitemap, robots, metadata, OpenGraph and social URLs.
# Temporary production canonical: https://www.scf.center. Change centrally when the final MMS domain is approved.
NEXT_PUBLIC_SITE_URL=https://www.scf.center/

# Release 1A public-surface feature gates.
# Defaults are secure in Vercel Production. Preview/local may expose approved development surfaces.
MMS_PROTOTYPE_ENABLED=false
MMS_PATIENT_PORTAL_ENABLED=false
MMS_MEMBERSHIP_CHECKOUT_ENABLED=false
MMS_PRODUCTION_LING_AI_ENABLED=false

# Release 2A internal Health Intelligence reviewer console and APIs.
# Explicitly enable only in local/Preview review environments. Production defaults off.
MMS_HEALTH_INTELLIGENCE_INTERNAL_ENABLED=false
# Synthetic reviewer dataset. The application refuses demo mode in Vercel Production.
MMS_HEALTH_INTELLIGENCE_DEMO_MODE=false
# Real collected data remains excluded from public Health Intelligence reads unless
# this separate release gate is explicitly enabled. Keep false in Production and Preview
# until source, verification, publication and medical-governance approval is complete.
MMS_HEALTH_INTELLIGENCE_REAL_DATA_ENABLED=false
# Signed reviewer-session lifetime; bounded to 15 minutes by default.
MMS_OPERATOR_SESSION_MAX_AGE_SECONDS=900
# Server-only HMAC secret for short-lived reviewer sessions.
MMS_OPERATOR_SESSION_SECRET=

# Dedicated MMS transactional commercial PostgreSQL database.
# Keep this separate from iPivot and from all patient/clinical databases.
# Server-side only. Do not prefix credentials with NEXT_PUBLIC_.
MMS_COMMERCIAL_DATABASE_URL=
MMS_COMMERCIAL_DATABASE_SCHEMA=mms_commercial
# Remain disabled until the foundation migration is applied and transactional adapters pass integration tests.
MMS_COMMERCIAL_DATABASE_ENABLED=false

# Partner Hub access. Keep disabled until a first-party Partner identity/session
# provider and the MMS commercial Hub datastore are both provisioned.
# Partner-facing routes must derive Partner ID from the verified server-side session;
# never accept Partner identity from a query parameter, localStorage or shared internal token.
MMS_PARTNER_HUB_ENABLED=false
# Non-production integration-test helper only. Requires MMS_PARTNER_HUB_ENABLED,
# the dedicated MMS commercial database and MMS_INTERNAL_API_TOKEN. The code also
# refuses to enable this path when NODE_ENV=production.
MMS_PARTNER_HUB_QA_BOOTSTRAP_ENABLED=false

# Permanent Sales Partner ID allocation.
# Current connected Zoho CRM edition does not support creating the required custom Partner Registry module,
# so allocation must remain disabled until an atomic backing registry is provisioned.
# Never implement Partner IDs as "highest MMSP number + 1" because concurrent approvals can issue duplicates.
MMS_PARTNER_ID_ALLOCATOR=disabled

# Stripe commerce placeholders. Server-side secrets must never use NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ASCEND=
STRIPE_PRICE_EVOLVE=
STRIPE_PRICE_ETERNA=
STRIPE_PRICE_PINNACLE=

# Commerce/recruitment feature gates. Keep false until integrations and policies are approved.
# Checkout requires BOTH Stripe Checkout and fulfilment gates to be true.
MMS_STRIPE_CHECKOUT_ENABLED=false
MMS_STRIPE_FULFILMENT_ENABLED=false
MMS_SALES_PARTNER_APPLICATIONS_ENABLED=false
MMS_CAREERS_APPLICATIONS_ENABLED=false

# Sales Partner CRM routing.
# Current safe interim mode is Leads because the connected Zoho CRM edition does not support the planned custom Sales Partners module.
# In Leads mode the website writes a tagged applicant record only; permanent Partner ID is issued only after approval through an atomic allocator.
MMS_SALES_PARTNER_CRM_MODE=leads
MMS_SALES_PARTNER_MODULE_API_NAME=
# This must be a valid Lead_Source picklist value in the MMS Zoho CRM. `Partner` is valid in the current connected schema.
MMS_SALES_PARTNER_LEAD_SOURCE=Partner
MMS_SALES_PARTNER_APPLICANT_TAG=MMS Sales Partner Applicant

# Careers / HR routing. Keep applications disabled until Zoho Recruit or another approved HR system is connected.
MMS_CAREERS_SYSTEM=zoho_recruit
MMS_CAREERS_OWNER_ID=

# Health education / SEO gates.
# Keep false until clinical, regulatory and Malaysian healthcare-advertising review is complete.
MMS_HEALTH_EDUCATION_INDEXABLE=false
MMS_MEDICAL_EDUCATION_INDEXABLE=false
