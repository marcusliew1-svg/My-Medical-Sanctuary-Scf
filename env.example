# MMS Zoho CRM integration placeholders. Do not commit real secrets.
# Server-side only. Do not prefix any Zoho secret with NEXT_PUBLIC_.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=com
ZOHO_ORGANIZATION_ID=
ZOHO_CRM_OWNER_ID=
ZOHO_LEADS_MODULE_API_NAME=Leads
MMS_DEFAULT_LEAD_SOURCE=Website Discovery Form
MMS_PARTNER_LEAD_SOURCE=MMS Partner Hub
MMS_CRM_DEBUG=true

# Partner Hub authentication safety gate.
# Keep false unless intentionally running the internal demo experience.
MMS_PARTNER_HUB_DEMO=false
MMS_PARTNER_HUB_DEMO_ROLE=partner

# Production Partner Hub infrastructure. Keep blank until approved providers are connected.
MMS_PARTNER_HUB_AUTH_PROVIDER=
MMS_PARTNER_HUB_DATABASE_URL=
MMS_PARTNER_HUB_PAYMENT_SOURCE=
